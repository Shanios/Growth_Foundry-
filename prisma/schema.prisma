generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String   @unique
  consent   Boolean
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  company   String?
  topic     String?
  message   String
  createdAt DateTime @default(now())
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(120)
  email        String?  @unique @db.VarChar(191)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

model CaseStudy {
  id            Int      @id @default(autoincrement())
  title         String   @db.VarChar(255)
  slug          String   @unique @db.VarChar(255)
  body          String   @db.LongText
  featuredImage String?  @db.Text
  sector        String   @default("General") @db.VarChar(120)
  outcome       String?  @db.VarChar(255)
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, createdAt])
  @@map("case_studies")
}

model BlogPost {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(255)
  body        String    @db.LongText
  coverImage  String?   @db.Text
  author      String    @default("Growth Foundry") @db.VarChar(120)
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
  @@map("blog_posts")
}

model ContactInquiry {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(160)
  email     String   @db.VarChar(191)
  company   String?  @db.VarChar(191)
  topic     String?  @db.VarChar(191)
  message   String   @db.Text
  status    String   @default("new") @db.VarChar(40)
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@map("contact_inquiries")
}
